# ABOUTME: Environment variables template for the wedding website

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated Supabase Auth user UUIDs explicitly permitted to access admin data/actions.
# Server-only. Empty or unset denies all admin access; never use NEXT_PUBLIC_ for this value.
ADMIN_USER_IDS=

# Site Password (shared password from invitation cards)
SITE_PASSWORD=your-wedding-password

# Independent server-only signing secret (at least 32 random characters).
# Never reuse SITE_PASSWORD or a Supabase key. Missing means household access is unavailable.
SESSION_SECRET=

# Email Configuration (Resend) - optional; set both values to enable delivery
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=

# Site URL (for email links)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
