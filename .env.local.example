# ABOUTME: Environment variables template for the wedding website

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site Password (shared password from invitation cards)
SITE_PASSWORD=your-wedding-password

# Email Configuration (Resend) - optional, emails skipped if not set
RESEND_API_KEY=your-resend-api-key

# Site URL (for email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
